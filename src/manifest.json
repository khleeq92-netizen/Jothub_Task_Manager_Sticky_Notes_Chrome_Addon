{
  "manifest_version": 3,
  "name": "Jot Hub — Notes, Tasks & Templates",
  "short_name": "Jot Hub",
  "version": "0.0.0",
  "description": "Sticky notes on any page, a task manager with reminders, ready-made templates and optional cloud sync. Works offline.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "contextMenus", "sidePanel", "identity"],
  "host_permissions": [
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Jot Hub",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+J" }, "description": "Open Jot Hub" },
    "new-note": { "suggested_key": { "default": "Alt+Shift+N" }, "description": "New sticky note on the current page" },
    "quick-task": { "suggested_key": { "default": "Alt+Shift+T" }, "description": "Quick task from the current page" },
    "open-hub": { "suggested_key": { "default": "Alt+Shift+H" }, "description": "Open the full hub in a tab" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
